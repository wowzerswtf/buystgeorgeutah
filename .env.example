# ─────────────────────────────────────────────────────────────
# Spark API / Flexmls IDX feed
# ─────────────────────────────────────────────────────────────
# Get these from https://sparkplatform.com or from Kayden's
# flexmls.com Developer/Spark API panel after his application
# is approved. See docs/IDX_SETUP.md for the full activation guide.

# Long-lived bearer token (the simplest path)
SPARK_API_KEY=

# Optional — override if Spark moves to a regional endpoint
# SPARK_API_BASE=https://api.sparkapi.com/v1

# Optional — extra RETS filter clause applied to every search,
# e.g. to scope to a specific MLS region. Example:
# SPARK_MLS_FILTER=MlsId Eq '20200518172608932582000000'
SPARK_MLS_FILTER=

# ─────────────────────────────────────────────────────────────
# Lead capture (pick one when ready)
# ─────────────────────────────────────────────────────────────
# RESEND_API_KEY=
# FORMSPREE_FORM_ID=

# ─────────────────────────────────────────────────────────────
# Analytics (optional)
# ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=buystgeorgeutah.com
